{
    "name": "ticketmallard",
    "version": "1.0.0",
    "scripts": {
        "build": "pnpm tsc",
        "dev": "pnpm dev:down && pnpm db:start",
        "dev:down": "docker compose down -v",
        "db:start": "pnpm dev:down && docker compose up -d --wait && drizzle-kit push && pnpm tsx test/db/seed.ts",
        "db:connect": "docker exec -it ticketmallard-postgres psql -U postgres -d ticketmallard",
        "db:tail": "docker logs -f ticketmallard-postgres",
        "test": "tsc && pnpm db:start && (node --import tsx --import ./test/setup.ts --test test/**/*.test.ts; pnpm dev:down)",
        "lint": "pnpm eslint . --fix",
        "format": "pnpm prettier --write \".\""
    },
    "type": "module",
    "dependencies": {
        "@fastify/cors": "^11.3.0",
        "@types/pg": "^8.23.1",
        "bullmq": "^6.2.0",
        "dotenv": "^17.4.2",
        "drizzle-orm": "1.0.0-rc.4",
        "fastify": "^5.12.1",
        "fastify-type-provider-zod": "^7.0.0",
        "ioredis": "^6.0.0",
        "postgres": "^3.4.9",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@fastify/sensible": "^6.0.5",
        "@types/node": "^26.2.0",
        "@types/sinon": "^22.0.0",
        "@typescript-eslint/eslint-plugin": "^8.67.0",
        "@typescript-eslint/parser": "^8.67.0",
        "drizzle-kit": "1.0.0-rc.4",
        "eslint": "^10.9.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-simple-import-sort": "^14.0.0",
        "eslint-plugin-unused-imports": "^4.4.1",
        "pino-pretty": "^13.1.3",
        "prettier": "^3.9.6",
        "sinon": "^22.1.0",
        "tsx": "^4.23.12",
        "typescript": "^6.0.2"
    }
}
